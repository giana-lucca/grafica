<%- include('../layout', { title: 'Novo Pedido', body: `
<h2>Novo Pedido</h2>
${erro ? '<div class="br-message danger"><div class="content">' + erro + '</div></div>' : ''}

${(usuario.perfil === 'admin' || usuario.perfil === 'operador') ? `
<div style="border:1px solid #c5d4eb;border-radius:8px;padding:1rem;margin-bottom:1.5rem;background:#f8fbff">
  <h3 style="margin-top:0">Cliente</h3>
  <div style="display:flex;gap:0.5rem;align-items:flex-end;flex-wrap:wrap">
    <div class="br-select">
      <label for="cli-tipo">Identificar por</label>
      <select id="cli-tipo" style="padding:0.5rem;border:1px solid #888;border-radius:4px">
        <option value="cpf">CPF</option>
        <option value="siape">SIAPE / Matrícula</option>
      </select>
    </div>
    <div class="br-input">
      <label for="cli-valor">Número</label>
      <input id="cli-valor" type="text">
    </div>
    <button class="br-button secondary" type="button" onclick="buscarCliente()">Buscar cliente</button>
  </div>

  <div id="cli-resultado" style="margin-top:0.75rem"></div>

  <div id="cli-novo" style="display:none;margin-top:0.75rem;padding-top:0.75rem;border-top:1px dashed #c5d4eb">
    <p style="margin:0 0 0.5rem">Cliente não encontrado. Cadastre os dados para continuar:</p>
    <div class="br-input"><label for="cli-nome">Nome</label><input id="cli-nome" type="text"></div>
    <div class="br-input"><label for="cli-email">E-mail</label><input id="cli-email" type="email"></div>
    <button class="br-button primary mt-2" type="button" onclick="cadastrarCliente()">Cadastrar e usar</button>
  </div>
</div>` : ''}

<!-- Wizard GOV.BR DS -->
<div class="br-wizard" data-scroll="false">
  <div class="wizard-progress">
    <button class="wizard-progress-btn" active step="1" type="button">Itens</button>
    <button class="wizard-progress-btn" step="2" type="button">Acabamento</button>
    <button class="wizard-progress-btn" step="3" type="button">Confirmar</button>
  </div>

  <!-- Etapa 1: Itens -->
  <div class="wizard-panel" active id="etapa-1">
    <div class="wizard-panel-content">
      <div class="br-input">
        <label for="sel-servico">Serviço</label>
        <select id="sel-servico" style="width:100%;padding:0.5rem;border:1px solid #888;border-radius:4px;font-size:1rem;">
          <option value="">Carregando...</option>
        </select>
      </div>
      <!-- Campos do item: só aparecem após escolher um serviço -->
      <div id="campos-item" style="display:none">
        <div class="br-input"><label>Quantidade</label>
          <input id="inp-qtd" type="number" min="1" value="1">
        </div>
        <!-- Campos de banner (largura/altura) mostrados condicionalmente -->
        <div id="campos-banner" style="display:none">
          <div class="br-input"><label>Largura (m)</label><input id="inp-larg" type="number" step="0.01"></div>
          <div class="br-input"><label>Altura (m)</label><input id="inp-alt" type="number" step="0.01"></div>
        </div>
        <button class="br-button secondary" type="button" onclick="adicionarItem()">Adicionar item</button>
      </div>

      <table class="br-table mt-3" id="tabela-itens">
        <thead><tr><th>Serviço</th><th>Qtd</th><th>Valor</th><th>Arte</th><th></th></tr></thead>
        <tbody id="tbody-itens"></tbody>
      </table>
      <p><strong>Total: R$ <span id="total">0,00</span></strong></p>
    </div>
    <div class="wizard-panel-btn">
      <button class="br-button primary" type="button" onclick="irEtapa(2)">Próximo</button>
    </div>
  </div>

  <!-- Etapa 2: Acabamento -->
  <div class="wizard-panel" id="etapa-2">
    <div class="wizard-panel-content">
      <div class="br-select"><label>Plastificação</label>
        <select id="sel-plast">
          <option value="">Sem plastificação</option>
          <option value="brilho">Brilho</option>
          <option value="fosco">Fosco</option>
        </select>
      </div>
      <div class="br-checkbox"><input id="cb-grampo" type="checkbox"><label for="cb-grampo">Grampo</label></div>
      <div class="br-checkbox"><input id="cb-vinco" type="checkbox"><label for="cb-vinco">Vinco</label></div>
      <div class="br-checkbox"><input id="cb-cola" type="checkbox"><label for="cb-cola">Cola</label></div>
    </div>
    <div class="wizard-panel-btn">
      <button class="br-button secondary" type="button" onclick="irEtapa(1)">Anterior</button>
      <button class="br-button primary" type="button" onclick="irEtapa(3)">Próximo</button>
    </div>
  </div>

  <!-- Etapa 3: Confirmar -->
  <div class="wizard-panel" id="etapa-3">
    <div class="wizard-panel-content">
      <div class="br-input"><label>Título do pedido</label><input id="inp-titulo" required></div>
      <div class="br-textarea"><label>Observações (opcional)</label><textarea id="inp-obs"></textarea></div>
      <p>Após salvar, você poderá fazer upload das artes e confirmar o pedido na página de detalhes.</p>
    </div>
    <div class="wizard-panel-btn">
      <button class="br-button secondary" type="button" onclick="irEtapa(2)">Anterior</button>
      <button class="br-button primary" type="button" onclick="salvar()">Salvar rascunho</button>
    </div>
  </div>
</div>

<form id="form-pedido" method="POST" action="/pedidos" style="display:none">
  <input type="hidden" name="titulo" id="hid-titulo">
  <input type="hidden" name="observacao_cliente" id="hid-obs">
  <input type="hidden" name="itens" id="hid-itens">
  <input type="hidden" name="acabamento" id="hid-acabamento">
  <input type="hidden" name="cliente_id" id="hid-cliente">
</form>
`, scripts: `
<script>
const STORAGE_KEY = 'rascunho-pedido:${usuario.id}';
const PERFIL = '${usuario.perfil}';
let clienteId = null;
let clienteSelecionado = null;

async function buscarCliente() {
  const tipo = document.getElementById('cli-tipo').value;
  const valor = document.getElementById('cli-valor').value.trim();
  if (!valor) { alert('Informe o CPF ou SIAPE.'); return; }
  const resp = await fetch('/admin/clientes/identificar', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ tipo, valor }),
  });
  const data = await resp.json();
  if (data.existe) {
    selecionarCliente(data.cliente);
  } else {
    clienteId = null;
    clienteSelecionado = null;
    document.getElementById('hid-cliente').value = '';
    document.getElementById('cli-resultado').innerHTML = '';
    document.getElementById('cli-novo').style.display = 'block';
    salvarEstado();
  }
}

async function cadastrarCliente() {
  const tipo = document.getElementById('cli-tipo').value;
  const valor = document.getElementById('cli-valor').value.trim();
  const nome = document.getElementById('cli-nome').value.trim();
  const email = document.getElementById('cli-email').value.trim();
  if (!nome || !email) { alert('Preencha nome e e-mail.'); return; }
  const resp = await fetch('/admin/clientes/identificar', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ tipo, valor, nome, email }),
  });
  const data = await resp.json();
  if (data.existe) {
    document.getElementById('cli-novo').style.display = 'none';
    selecionarCliente(data.cliente, data.criado);
  } else {
    alert(data.erro || 'Não foi possível cadastrar o cliente.');
  }
}

function selecionarCliente(cliente, criado) {
  clienteId = cliente.id;
  clienteSelecionado = cliente;
  document.getElementById('hid-cliente').value = cliente.id;
  const ident = cliente.cpf ? 'CPF ' + cliente.cpf : 'SIAPE ' + cliente.matricula;
  document.getElementById('cli-resultado').innerHTML =
    '<div class="br-message success"><div class="content"><strong>' + cliente.nome + '</strong> (' + cliente.email + ') — ' + ident +
    (criado ? ' · <em>novo cadastro</em>' : '') + '</div></div>';
  salvarEstado();
}

let catalogo = [];
let itensPedido = [];
let total = 0;

// Carrega catálogo ao iniciar e depois restaura rascunho salvo
fetch('/api/catalogo-ativo').then(r => r.json()).then(data => {
  catalogo = data;
  const sel = document.getElementById('sel-servico');
  sel.innerHTML = '<option value="">— Selecione um serviço —</option>' + data.map(s =>
    '<option value="' + s.id + '" data-tipo="' + s.tipo + '">' + s.descricao + '</option>'
  ).join('');
  sel.addEventListener('change', atualizarCamposItem);
  atualizarCamposItem();
  restaurarEstado();
});

// Mostra os campos do item só após escolher um serviço e ajusta para banner
function atualizarCamposItem() {
  const sel = document.getElementById('sel-servico');
  const opt = sel.options[sel.selectedIndex];
  const temServico = !!sel.value;
  document.getElementById('campos-item').style.display = temServico ? 'block' : 'none';
  document.getElementById('campos-banner').style.display =
    (temServico && opt.dataset.tipo === 'banner') ? 'block' : 'none';
}

// Salva o que já foi preenchido em qualquer alteração dos campos finais
['inp-titulo','inp-obs','sel-plast','cb-grampo','cb-vinco','cb-cola'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener('change', salvarEstado);
  if (el) el.addEventListener('input', salvarEstado);
});

function salvarEstado() {
  const estado = {
    cliente: clienteSelecionado,
    itens: itensPedido,
    titulo: document.getElementById('inp-titulo').value,
    obs: document.getElementById('inp-obs').value,
    plast: document.getElementById('sel-plast').value,
    grampo: document.getElementById('cb-grampo').checked,
    vinco: document.getElementById('cb-vinco').checked,
    cola: document.getElementById('cb-cola').checked,
  };
  localStorage.setItem(STORAGE_KEY, JSON.stringify(estado));
}

function restaurarEstado() {
  const raw = localStorage.getItem(STORAGE_KEY);
  if (!raw) return;
  let estado;
  try { estado = JSON.parse(raw); } catch (e) { return; }
  itensPedido = estado.itens || [];
  renderTabela();
  document.getElementById('inp-titulo').value = estado.titulo || '';
  document.getElementById('inp-obs').value = estado.obs || '';
  document.getElementById('sel-plast').value = estado.plast || '';
  document.getElementById('cb-grampo').checked = !!estado.grampo;
  document.getElementById('cb-vinco').checked = !!estado.vinco;
  document.getElementById('cb-cola').checked = !!estado.cola;
  // Restaura o cliente selecionado (só existe na tela do admin/operador)
  if (estado.cliente && document.getElementById('cli-resultado')) {
    selecionarCliente(estado.cliente);
  }
}

function renderTabela() {
  total = 0;
  const tbody = document.getElementById('tbody-itens');
  tbody.innerHTML = '';
  itensPedido.forEach((item, i) => {
    total += Number(item.valor);
    const tr = document.createElement('tr');
    tr.innerHTML = '<td>' + (item.descricao || item.tipo) + '</td><td>' + item.quantidade + '</td><td>R$ ' + Number(item.valor).toFixed(2) + '</td><td><span class="br-tag warning">Aguardando</span></td><td><button type="button" onclick="removerItem(' + i + ')">&#x2715;</button></td>';
    tbody.appendChild(tr);
  });
  document.getElementById('total').textContent = total.toFixed(2).replace('.',',');
}

async function adicionarItem() {
  const sel = document.getElementById('sel-servico');
  const id = sel.value;
  if (!id) { alert('Selecione um serviço.'); return; }
  const descricao = sel.options[sel.selectedIndex].text;
  const tipo = sel.options[sel.selectedIndex].dataset.tipo;
  const qtd = parseInt(document.getElementById('inp-qtd').value);
  if (tipo === 'banner') {
    const larg = parseFloat(document.getElementById('inp-larg').value);
    const alt = parseFloat(document.getElementById('inp-alt').value);
    if (!larg || !alt) { alert('Informe largura e altura do banner.'); return; }
  }
  const opcoes = tipo === 'banner' ? {
    largura: parseFloat(document.getElementById('inp-larg').value),
    altura: parseFloat(document.getElementById('inp-alt').value),
  } : {};

  try {
    const resp = await fetch('/api/calcular-item', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ catalogo_servico_id: id, quantidade: qtd, opcoes }),
    });
    if (!resp.ok) throw new Error('Erro ao calcular preço');
    const { valor } = await resp.json();

    itensPedido.push({ catalogo_servico_id: id, tipo, quantidade: qtd, valor, opcoes, descricao });
    renderTabela();
    salvarEstado();
    // limpa para o próximo item
    sel.value = '';
    document.getElementById('inp-qtd').value = 1;
    atualizarCamposItem();
  } catch (err) {
    alert('Erro ao adicionar item: ' + err.message);
  }
}

function removerItem(idx) {
  itensPedido.splice(idx, 1);
  renderTabela();
  salvarEstado();
}

function irEtapa(n) {
  document.querySelectorAll('.wizard-panel').forEach((p, i) => {
    if (i + 1 === n) p.setAttribute('active', ''); else p.removeAttribute('active');
  });
  document.querySelectorAll('.wizard-progress-btn').forEach((b, i) => {
    if (i + 1 === n) b.setAttribute('active', ''); else b.removeAttribute('active');
  });
}

function submeterForm() {
  if ((PERFIL === 'admin' || PERFIL === 'operador') && !clienteId) {
    alert('Identifique o cliente (CPF ou SIAPE) antes de salvar.');
    return;
  }
  salvarEstado();
  document.getElementById('hid-cliente').value = clienteId || '';
  document.getElementById('hid-titulo').value = document.getElementById('inp-titulo').value;
  document.getElementById('hid-obs').value = document.getElementById('inp-obs').value;
  document.getElementById('hid-itens').value = JSON.stringify(itensPedido);
  const acab = {
    plastificacao: document.getElementById('sel-plast').value || null,
    grampo: document.getElementById('cb-grampo').checked,
    vinco: document.getElementById('cb-vinco').checked,
    cola: document.getElementById('cb-cola').checked,
    valor: 0,
  };
  document.getElementById('hid-acabamento').value = JSON.stringify(acab);
  document.getElementById('form-pedido').submit();
}

function salvar() { submeterForm(); }
</script>
` }) %>
