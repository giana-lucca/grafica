<%- include('../layout', { title: 'Pedido ' + pedido.numero, body: `
<nav class="br-breadcrumb" aria-label="Breadcrumbs">
  <ol class="crumb-list">
    <li class="crumb"><a href="/pedidos">Meus Pedidos</a></li>
    <li class="crumb" data-active="active"><span style="margin:0 .5rem;color:#888">›</span><span aria-current="page">${pedido.numero}</span></li>
  </ol>
</nav>

${erro ? '<div class="br-message danger"><div class="content">' + erro + '</div></div>' : ''}

<h2>Pedido ${pedido.numero} — ${pedido.titulo}</h2>
<p><strong>Status:</strong> <span class="br-tag">${pedido.status.replace(/_/g,' ')}</span></p>
${pedido.prazo_entrega ? '<p><strong>Data prevista:</strong> ' + new Date(pedido.prazo_entrega).toLocaleDateString('pt-BR') + '</p>' : ''}
${pedido.numero_transferencia ? '<p><strong>Número da transferência:</strong> ' + pedido.numero_transferencia + '</p>' : ''}

<h3>Itens</h3>
<table class="br-table">
  <thead><tr><th>Serviço</th><th>Qtd</th><th>Valor</th><th>Arte</th><th></th></tr></thead>
  <tbody>
    ${pedido.itens.map(i => `
    <tr style="${i.ativo ? '' : 'opacity:0.55'}">
      <td style="${i.ativo ? '' : 'text-decoration:line-through'}">${i.tipo}${i.ativo ? '' : ' <span class="br-tag danger" style="text-decoration:none">removido</span>'}</td>
      <td style="${i.ativo ? '' : 'text-decoration:line-through'}">${i.quantidade}</td>
      <td style="${i.ativo ? '' : 'text-decoration:line-through'}">R$ ${Number(i.valor).toFixed(2)}</td>
      <td>
        ${i.nome_original
          ? '<a href="/pedidos/' + pedido.id + '/itens/' + i.id + '/arquivo/' + i.arquivo_id + '" target="_blank">' + i.nome_original + '</a>'
          : (i.ativo && (pedido.status === 'rascunho' || pedido.status === 'pendencia') ? `
        <form id="form-upload-${i.id}" enctype="multipart/form-data">
          <input type="file" id="file-${i.id}" accept=".pdf,.png,.jpg,.jpeg,.ai,.cdr">
          <button type="button" class="br-button secondary small" onclick="uploadArte('${pedido.id}', '${i.id}')">Enviar arte</button>
        </form>
        <span id="status-${i.id}"></span>` : '<span class="br-tag danger">Sem arquivo</span>')}
      </td>
      <td>
        ${i.ativo && (pedido.status === 'rascunho' || pedido.status === 'pendencia') ? `
        <form method="POST" action="/pedidos/${pedido.id}/itens/${i.id}/inativar" onsubmit="return confirm('Remover este item do pedido?')">
          <button class="br-button danger small" type="submit">Remover</button>
        </form>` : ''}
      </td>
    </tr>`).join('')}
  </tbody>
  <tfoot>
    <tr>
      <td colspan="2" style="text-align:right"><strong>Total do pedido</strong></td>
      <td colspan="3"><strong>R$ ${pedido.itens.filter(i => i.ativo).reduce((acc, i) => acc + Number(i.valor), 0).toFixed(2)}</strong></td>
    </tr>
  </tfoot>
</table>

${(pedido.status === 'rascunho' || pedido.status === 'pendencia') ? `
<details style="margin:1rem 0">
  <summary style="cursor:pointer;color:#1351b4;font-weight:600">+ Adicionar item</summary>
  <form method="POST" action="/pedidos/${pedido.id}/itens" style="margin-top:0.75rem;border:1px solid #c5d4eb;border-radius:8px;padding:1rem;max-width:480px">
    <div class="br-input">
      <label for="add-servico">Serviço</label>
      <select id="add-servico" name="catalogo_servico_id" required style="width:100%;padding:0.5rem;border:1px solid #888;border-radius:4px" onchange="toggleBanner()">
        <option value="">— Selecione um serviço —</option>
        ${(typeof catalogo !== 'undefined' ? catalogo : []).map(s => '<option value="' + s.id + '" data-tipo="' + s.tipo + '">' + s.descricao + '</option>').join('')}
      </select>
    </div>
    <div class="br-input"><label for="add-qtd">Quantidade</label><input id="add-qtd" name="quantidade" type="number" min="1" value="1" required></div>
    <div id="add-banner" style="display:none">
      <div class="br-input"><label>Largura (m)</label><input name="largura" type="number" step="0.01"></div>
      <div class="br-input"><label>Altura (m)</label><input name="altura" type="number" step="0.01"></div>
    </div>
    <button class="br-button primary mt-2" type="submit">Adicionar</button>
  </form>
</details>` : ''}

${pedido.status === 'rascunho' ? `
<h3>Confirmar pedido</h3>
<p>Após enviar as artes de todos os itens, preencha o número da transferência e confirme o pedido.</p>
<form method="POST" action="/pedidos/${pedido.id}/confirmar">
  <div class="br-input"><label>Número da transferência bancária</label>
    <input name="numero_transferencia" required>
  </div>
  <button class="br-button primary" type="submit">Confirmar pedido</button>
</form>` : ''}

<h3>Histórico</h3>
<ul style="list-style:none;padding:0;margin:0 0 0 6px;border-left:2px solid #c5d4eb">
  ${pedido.historico.map(h => `
  <li style="position:relative;padding:0 0 1.5rem 1.5rem">
    <span style="position:absolute;left:-7px;top:3px;width:12px;height:12px;border-radius:50%;background:#1351b4"></span>
    <div style="font-weight:600">${h.status_novo.replace(/_/g,' ')}</div>
    <div style="font-size:0.85rem;color:#666">${h.nome_usuario} — ${new Date(h.created_at).toLocaleString('pt-BR')}</div>
    ${h.comentario ? '<div style="margin-top:0.25rem">' + h.comentario + '</div>' : ''}
  </li>`).join('')}
</ul>

${pedido.status === 'pendencia' ? `
<h3>Responder pendência</h3>
<form method="POST" action="/pedidos/${pedido.id}/responder">
  <div class="br-textarea"><label>Sua resposta</label><textarea name="comentario" required></textarea></div>
  <button class="br-button primary" type="submit">Enviar resposta</button>
</form>` : ''}
`, scripts: `
<script>
// Acabou de salvar o rascunho: limpa o rascunho guardado no navegador
if (new URLSearchParams(location.search).get('criado') === '1') {
  localStorage.removeItem('rascunho-pedido:${usuario.id}');
}

function toggleBanner() {
  const sel = document.getElementById('add-servico');
  if (!sel) return;
  const tipo = sel.options[sel.selectedIndex].dataset.tipo;
  document.getElementById('add-banner').style.display = tipo === 'banner' ? 'block' : 'none';
}

async function uploadArte(pedidoId, itemId) {
  const fileInput = document.getElementById('file-' + itemId);
  if (!fileInput.files[0]) { alert('Selecione um arquivo.'); return; }
  const form = new FormData();
  form.append('arquivo', fileInput.files[0]);
  try {
    const resp = await fetch('/pedidos/' + pedidoId + '/itens/' + itemId + '/arquivo', {
      method: 'POST', body: form
    });
    if (!resp.ok) throw new Error('Erro no upload');
    const data = await resp.json();
    document.getElementById('status-' + itemId).textContent = '✓ ' + data.nome_original;
    document.getElementById('form-upload-' + itemId).style.display = 'none';
  } catch (err) {
    alert('Erro ao enviar arte: ' + err.message);
  }
}
</script>
` }) %>
